  m_Script: {fileID: 11500000, guid: fe0ed64885b04704fa96f94d85ba14f2, type: 3}
  m_Name: "\u738B\u5BAB\u5BF9\u767D"
  m_EditorClassIdentifier: 
  npcData: {fileID: 11400000, guid: 1fedc4850c27787499177d0a16b35093, type: 2}
  dialogueContent:
  - "\uFF08\u4E00\u88AD\u7384\u888D\u7684\u5546\u738B\u7AEF\u5750\u9AD8\u53F0\uFF0C\u76EE\u5149\u5982\u70AC\uFF0C\u4FEF\u89C6\u7740\u4F60\u3002\uFF09"
  - "\u6765\u8005\u4F55\u4EBA\uFF1F\u7ADF\u6562\u95EF\u5165\u6BB7\u5546\u738B\u5BAB\uFF1F"
  - "\u2026\u2026\u5947\u4EBA\u5F02\u58EB\uFF1F\u54FC\u3002\u5012\u50CF\u662F\u4ECE\u9065\u8FDC\u4E4B\u5730\u6765\u7684\u8FC7\u5BA2\u3002"
  - "\u4E5F\u7F62\u3002\u5BE1\u4EBA\u53D7\u795E\u7941\u6258\u68A6\uFF0C\u79F0\u9700\u628A\u5723\u7269\u4EA4\u4E88\u5408\u9002\u4E4B\u4EBA\u3002\u89C1\u4F60\u6765\u5386\u79BB\u5947\uFF0C\u4FBF\u8D50\u4F60\u56DB\u7247\u7532\u9AA8\u2014\u2014\u8FD9\u662F\u5929\u547D\u4E4B\u8BB0\uFF0C\u8BB0\u7740\u56DB\u4E2A\u53E4\u5B57\u3002"
  - "\u5E26\u7740\u5B83\u4EEC\u53BB\u5427\u3002\u5018\u82E5\u4F60\u771F\u6709\u5F52\u9014\uFF0C\u8FD9\u56DB\u5B57\u7EC8\u4F1A\u6307\u5F15\u4F60\u56DE\u5BB6\u3002"
  - "\uFF08\u5546\u738B\u6325\u8896\uFF0C\u56DB\u7247\u523B\u5B57\u7684\u7532\u677F\u81EA\u5929\u800C\u964D\uFF0C\u98D8\u5165\u4F60\u6000\u4E2D\u3002\uFF09"
  dialogueOptions: []
  NextDialogueNode: {fileID: 0}
