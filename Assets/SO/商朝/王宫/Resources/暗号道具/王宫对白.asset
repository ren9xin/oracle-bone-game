  - targetObjectName: "\u5267\u60C5\u7CFB\u7EDF"
    callbackFunctionName: "\u8D4B\u4E88\u6697\u53F7\u9053\u5177"
  - targetObjectName: "\u5267\u60C5\u7CFB\u7EDF"
