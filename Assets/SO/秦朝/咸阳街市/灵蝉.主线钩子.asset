  dialogueContent:
  - "\u4F46\u6709\u4EF6\u4E8B\u6211\u5F97\u544A\u8BC9\u4F60\u3002"
  - "\u90A3\u6279\u7AF9\u7B80\u91CC\uFF0C\u6709\u5341\u51E0\u5377\u662F\u5546\u671D\u4F20\u4E0B\u6765\u7684\u7532\u9AA8\u6587\u62D3\u672C\u2014\u2014\u65E5\u600E\u4E48\u5199\u3001\u796D\u957F\u4EC0\u4E48\u6837\u3001\u518C\u662F\u51E0\u6761\u7AF9\u7247\u7A7F\u8D77\u6765\u7684\u2026\u2026"
  - "\u70E7\u4E86\uFF0C\u5C31\u518D\u6CA1\u4EBA\u8BB0\u5F97\u4E86\u3002"
  - "\u4ECA\u591C\u57CE\u5916\u7684\u592A\u5B66\u85CF\u4E66\u9601\u4F1A\u88AB\u70B9\u706B\u3002\u4F60\u80FD\u4E0D\u80FD\u2026\u2026\u8FDB\u53BB\u6551\u51E0\u5377\u51FA\u6765\uFF1F"
  dialogueOptions:
