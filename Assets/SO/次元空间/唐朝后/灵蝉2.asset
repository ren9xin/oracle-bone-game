  npcData: {fileID: 11400000, guid: 33382451f74e6cc449c944b3d1435671, type: 2}
  dialogueContent:
  - "\u8FD9\u4E0B\u7B2C\u56DB\u4E2A\u4F20\u9001\u95E8\u4E5F\u8981\u6253\u5F00\u4E86\uFF0C\u4F60\u53EF\u4EE5\u56DE\u5BB6\u4E86\u3002"
  - "\u4F60\u771F\u662F\u4E2A\u4E0D\u53EF\u601D\u8BAE\u7684\u4EBA\u3002"
  - "\u7A7F\u8D8A\u4E86\u5546\u671D\u3001\u79E6\u671D\u3001\u5510\u671D\uFF0C\u9047\u89C1\u4E86\u6570\u4E0D\u6E05\u7684\u4EBA\u548C\u4E8B\u3002"
  - "\u4F46\u4F60\u4F9D\u7136\u80FD\u591F\u5728\u5176\u4E2D\u575A\u5B88\u6700\u7EAF\u771F\u7684\u81EA\u6211\uFF0C\u5728\u56F0\u5883\u4E2D\u62FC\u547D\u5BFB\u627E\u51FA\u8DEF\uFF0C\u62EF\u6551\u6D88\u901D\u7684\u6587\u5B57\u3002"
  - "\u6587\u5316\u4E0E\u6587\u5B57\u9700\u8981\u4F60\u8FD9\u6837\u7684\u4EBA\u6765\u4F20\u627F\u3002"
  - "\u867D\u7136\u4F60\u4ECA\u540E\u4E00\u5B9A\u4E5F\u4F1A\u9762\u4E34\u5404\u79CD\u6311\u6218\uFF0C\u4F46\u6211\u76F8\u4FE1\u4F60\u4E00\u5B9A\u80FD\u591F\u5766\u7136\u8DE8\u8FC7\u6240\u6709\u969C\u788D\u7684\u5427\u3002"
  - "\u7B49\u4F60\u56DE\u5230\u539F\u6765\u7684\u4E16\u754C\uFF0C\u8BF7\u4E0D\u8981\u5FD8\u8BB0\u73B0\u5728\u53D1\u751F\u8FC7\u7684\u4E8B\uFF0C\u6587\u5B57\u7684\u6839\u6E90\u4E00\u5B9A\u4F1A\u5F15\u5BFC\u4F60\u8D70\u5411\u66F4\u597D\u7684\u672A\u6765\u3002"
  dialogueOptions: []
  NextDialogueNode: {fileID: 0}
  callbacks:
  - targetObjectName: "\u7CBE\u7075"
    callbackFunctionName: disappear
